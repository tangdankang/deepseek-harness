{
  "name": "@deepseek-ai/dsh-vscode",
  "description": "VS Code extension host for the DeepSeek Harness coding agent runtime",
  "version": "0.1.0-rc.7",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "apps/vscode"
  },
  "type": "module",
  "files": [
    "extension"
  ],
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=extension/dist/extension.cjs && esbuild tests/extension-host.ts --bundle --platform=node --format=cjs --external:vscode --outfile=lib/extension-host-test.cjs",
    "watch": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=extension/dist/extension.cjs --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-host-apiproxy": "workspace:^",
    "@deepseek-ai/dsh-host-apiproxy-stdio": "workspace:^",
    "@deepseek-ai/dsh-sdk-protocol": "workspace:^",
    "cross-spawn": "^7.0.6",
    "micromark": "^4.0.2"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/vscode": "^1.106.0",
    "esbuild": "^0.25.0"
  }
}
