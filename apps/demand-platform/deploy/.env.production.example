CONFIRMATION_SECRET=replace-with-at-least-32-random-characters
RUNTIME_PROFILE=PILOT_SINGLE_NODE_SQLITE
MOCK_WEBHOOK_SECRET=replace-with-a-different-random-secret
INBOUND_WEBHOOK_SECRET_ENVS={"CRM":"CRM_WEBHOOK_SECRET"}
CRM_WEBHOOK_SECRET=replace-with-a-dedicated-crm-inbound-webhook-secret
BUSINESS_WEBHOOK_MAX_AGE_SECONDS=86400
TOOL_API_KEY=replace-with-a-dedicated-deap-tool-key
ADMIN_API_KEY=replace-with-a-dedicated-operations-key
METRICS_API_KEY=replace-with-a-dedicated-monitoring-scrape-key
IDENTITY_HMAC_SECRET=replace-with-a-gateway-signing-secret
IDENTITY_EVENT_SECRET=replace-with-a-dedicated-identity-event-signing-secret
IDENTITY_EVENT_SOURCE=company-identity-gateway
IDENTITY_EVENT_MAX_AGE_SECONDS=86400
OPERATOR_HMAC_SECRET=replace-with-an-operator-gateway-signing-secret
IDENTITY_EXCHANGE_MODE=both
IDENTITY_EXCHANGE_SECRET=replace-with-a-dedicated-one-time-ticket-secret
IDENTITY_EXCHANGE_ISSUER=company-identity-gateway
IDENTITY_EXCHANGE_AUDIENCE=ai-demand-platform
ANALYTICS_HASH_SECRET=replace-with-a-dedicated-analytics-secret
AUDIT_CHAIN_SECRET=replace-with-a-dedicated-audit-integrity-secret
AUDIT_CHAIN_KEY_VERSION=1
AUDIT_CHAIN_ALLOW_LEGACY_BACKFILL=false
CONNECTOR_CONFIG_PATH=/run/config/connectors.json
CRM_CONNECTOR_TOKEN=replace-with-test-or-production-secret-from-kms
CONFIRMATION_TTL_SECONDS=600
IDENTITY_TTL_SECONDS=300
OPERATOR_IDENTITY_TTL_SECONDS=300
IDENTITY_EXCHANGE_TTL_SECONDS=90
INTEGRATION_MAX_ATTEMPTS=5
INTEGRATION_RETRY_BASE_SECONDS=30
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=15000
KEEP_ALIVE_TIMEOUT_MS=5000
GRACEFUL_SHUTDOWN_MS=15000
SESSION_TTL_SECONDS=3600
SESSION_MAX_PER_EMPLOYEE=10
SESSION_COOKIE_SECURE=true
OPERATOR_SESSION_TTL_SECONDS=1800
OPERATOR_SESSION_MAX_PER_OPERATOR=5
OPERATOR_BOOTSTRAP_ENABLED=false
TOOL_INVOCATION_RETENTION_DAYS=90
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
EMPLOYEE_RATE_LIMIT=120
TOOL_RATE_LIMIT=300
AUTH_RATE_LIMIT=600
ADMIN_RATE_LIMIT=300
WEBHOOK_RATE_LIMIT=600
RATE_LIMIT_MAX_ENTRIES=50000
